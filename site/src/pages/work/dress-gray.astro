---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import dressgrayFeature from '../../assets/images/work/dressgray-feature.webp';
import dressgrayLetterhead from '../../assets/images/work/dressgray-tile-letterhead.webp';
import dressgrayMug from '../../assets/images/work/dressgray-tile-mug.webp';
import dressgrayBrochure from '../../assets/images/work/dressgray-tile-brochure.webp';
---
<CaseStudyLayout
  client="dress gray"
  summary="A construction management company that wanted strategic thinking first — before any new logo, any new colors, any new anything."
  description="How Tingen Creative ran a discovery and brand strategy engagement for dress gray, producing a real Brand Strategy Roadmap."
  path="/work/dress-gray"
  heroImage={dressgrayFeature}
  heroImageAlt="dress gray branded hard hat"
  squareImage1={dressgrayLetterhead}
  squareImage1Alt="dress gray branded letterhead"
  squareImage2={dressgrayMug}
  squareImage2Alt="dress gray branded mug"
  rectImage={dressgrayBrochure}
  rectImageAlt="dress gray brochure — Solutions Not Surprises"
  servicesUsed={['Brand Alignment']}
  challenge="dress gray was already working under that name in construction management and development, but hadn't yet clearly defined who they served, why it mattered, or how they differed from other firms in the industry."
  approach="A Discovery Session to unearth what the owner and stakeholders had already built, followed by a Strategy Workshop — including client interviews — to sharpen the audience and clarify how dress gray presents itself, before any visual work began."
  result="dress gray is well on its way to establishing itself in construction management and development — with two engagements already in the works and another proposal just sent out on the back of the new positioning."
/>
