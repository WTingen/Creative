---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import svnFeature from '../../assets/images/work/svn-feature.webp';
import svnReport1 from '../../assets/images/work/svn-cky-tile-report1.webp';
import svnHeadshot from '../../assets/images/work/svn-cky-tile-headshot.webp';
import svnReport2 from '../../assets/images/work/svn-cky-tile-report2.webp';
---
<CaseStudyLayout
  client="SVN | Stone Commercial Real Estate"
  summary="A Central Kentucky industrial market report built to travel — social media, print leave-behinds, and everywhere in between."
  description="How Tingen Creative designed and produced a Central Kentucky industrial market report for SVN | Stone Commercial Real Estate."
  path="/work/svn-central-kentucky"
  heroImage={svnFeature}
  heroImageAlt="SVN Industrial Market Report, Central Kentucky — open booklet showing an industrial property and regional map"
  squareImage1={svnReport1}
  squareImage1Alt="SVN Central Kentucky market report interior spread"
  squareImage2={svnHeadshot}
  squareImage2Alt="John Bunch, SIOR, SVN | Stone Commercial Real Estate"
  rectImage={svnReport2}
  rectImageAlt="SVN Central Kentucky market report, Lexington skyline spread"
  servicesUsed={['Monthly Marketing']}
  challenge="John Bunch, SIOR needed a new market report for his Central Kentucky region — one that stayed true to the SVN brand standard while being attractive, engaging, and portable across print and digital formats."
  approach="A showcase report designed and laid out to SVN's direction: regional data, maps, and property detail turned into something the team could hand to a client in person or post directly to social media."
  result="Well received by industry professionals across the region — distributed both digitally and as printed leave-behinds at client visits."
  testimonial={{
    quote:
      "I met Warren Tingen on LinkedIn. He called me to introduce himself and succinctly told me how he could help me. This guy's skill is unreal. He created the graphic and layout of this entire report. Our internal marketing team worked in tandem with Warren and made this process a seamless one.",
    name: 'John Bunch, SIOR',
    title: 'SVN | Stone Commercial Real Estate',
  }}
/>
