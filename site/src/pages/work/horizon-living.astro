---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import horizonFeature from '../../assets/images/work/horizon-feature.webp';
import horizonRackcard from '../../assets/images/work/horizon-tile-rackcard.webp';
import horizonFlyer from '../../assets/images/work/horizon-tile-flyer.webp';
import horizonBrochure from '../../assets/images/work/horizon-tile-brochure.webp';
---
<CaseStudyLayout
  client="Horizon Living"
  summary="A Manor Lake independent living community in Hoschton, GA, whose identity didn't match its audience — realigned from the ground up to the signage people actually see driving in."
  description="How Tingen Creative realigned the brand identity and built the lease-up collateral suite for Horizon Living, a Manor Lake independent living community."
  path="/work/horizon-living"
  heroImage={horizonFeature}
  heroImageAlt="Horizon Living monument sign — A Manor Lake Independent Living Community, Hoschton"
  squareImage1={horizonRackcard}
  squareImage1Alt="Horizon Living rack card"
  squareImage2={horizonFlyer}
  squareImage2Alt="Horizon Living flyer"
  rectImage={horizonBrochure}
  rectImageAlt="Horizon Living brochure — Elevated Living"
  servicesUsed={['Built Brand Foundations']}
  challenge="Horizon Living already had an identity, but it didn't match the audience it needed to reach — and it didn't feel connected to the Manor Lake brand it belonged under. Manor Lake asked Tingen Creative to fix that before the community opened."
  approach="Rather than building something disconnected, we designed an identity that kept elements of the Manor Lake brand and expanded on them, then built it out across every touchpoint a prospective resident or family would encounter: monument signage, brochures, flyers, and rack cards — consistent from the entrance sign to the leasing table."
  result="One of Tingen Creative's largest engagements to date — the first of many planned communities under the Manor Lake umbrella, and proof that a brand identity has to hold up in the physical world, not just on a screen."
  testimonial={{
    quote:
      "Working with Warren and the team at Tingen Creative was a seamless experience from start to finish. We came to them with a vision for branding our newest independent living development, Horizon, and they delivered quickly and efficiently. The final logo and marketing materials captured the essence of what we were building — freedom, comfort, and community for active seniors. We had a tight timeline, but their professionalism and creative clarity made it easy.",
    name: 'Samantha Lee, LPN, CEA, CALA',
    title: 'Vice President of Operations, Manor Lake Management',
  }}
/>
