  description="How Tingen Creative built the brand identity and lease-up collateral suite for Horizon Living, a Manor Lake independent living community."
  path="/work/horizon-living"
  heroImage={horizonFeature}
  heroImageAlt="Horizon Living monument sign — A Manor Lake Independent Living Community, Hoschton"
