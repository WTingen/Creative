---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import marketingImg from '../assets/images/services/marketing-brochure.webp';
import architecturalSketch from '../assets/images/illustrations/architectural-sketch-001.webp';
import { SITE_URL, BUSINESS_NAME } from '../lib/contact';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Brand Strategy and Identity Design',
  provider: { '@type': 'ProfessionalService', name: BUSINESS_NAME, url: SITE_URL },
  areaServed: 'US',
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Commercial real estate, development, and construction companies',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Tingen Creative Services',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Built Brand Foundations',
        description:
          'A three-phase brand build for companies starting from scratch: Brand Master Plan, Brand Build, and Brand Capstone.',
        price: '15000',
        priceCurrency: 'USD',
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '15000',
          priceCurrency: 'USD',
          description: 'Starting price for Phase I of III; full engagement priced by phase.',
        },
      },
      {
        '@type': 'Offer',
        name: 'Brand Alignment',
        description:
          'For companies with an existing logo and colors but no codified brand system — discovery, workshop, and roll-out.',
        price: '9500',
        priceCurrency: 'USD',
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '9500',
          priceCurrency: 'USD',
          description: 'Starting price.',
        },
      },
      {
        '@type': 'Offer',
        name: 'Monthly Marketing',
        description: 'An ongoing marketing subscription — flyers, social graphics, ads, presentations, and more.',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '3500',
          priceCurrency: 'USD',
          unitText: 'MONTH',
          description: 'Starting tier; a $4,995/month tier is also available.',
        },
      },
    ],
  },
};

const foundationsPhases = [
  {
    number: '01',
    name: 'Brand Master Plan',
    timeline: '2–4 weeks',
    price: '$15,000',
    blurb:
      "We listen first — understanding your goals and the audience you're trying to reach. Research and positioning determine how your brand will be perceived, and how it stands apart from the competition.",
  },
  {
    number: '02',
    name: 'Brand Build',
    timeline: '2–3 weeks',
    price: '$30,000',
    priceNote: '*',
    blurb:
      'Naming, voice, and visual identity — the elements that make a brand recognizable and memorable, built to work across everything from a business card to a leasing brochure.',
  },
  {
    number: '03',
    name: 'Brand Capstone',
    timeline: '4 weeks',
    price: '$15,000',
    blurb:
      "A style guide to keep the brand consistent going forward, plus the first wave of collateral built from it — so the new brand is already at work by the time we're done.",
  },
];

const alignmentStages = [
  {
    number: '01',
    name: 'Discovery & Alignment',
    blurb:
      "A workshop with your team — not just a conversation with one person, but the people who actually run the business day to day. We dig into what's working, what's not, and where the brand and the business have drifted apart.",
  },
  {
    number: '02',
    name: 'Codify & Roll Out',
    blurb:
      'Everything gets written down: a real brand guide, applied to your actual materials, with a plan for keeping it consistent as you grow.',
  },
];

const marketingTiers = [
  {
    price: '$3,500',
    features: ['One request at a time', 'One user', '48-hour average turnaround', 'Cancel anytime'],
  },
  {
    price: '$4,995',
    features: ['Up to two requests at a time', 'Up to two users', '48-hour average turnaround', 'Cancel anytime'],
    featured: true,
  },
];
---
<BaseLayout
  title="Services"
  description="Three ways to work with Tingen Creative — build a brand from the ground up, align a brand that already has pieces but no system, or keep monthly marketing moving."
  path="/services"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- Intro -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-20 bg-tc-paper"></div>
    <div class="absolute -top-24 -left-20 -z-10 h-80 w-80 sm:h-[26rem] sm:w-[26rem] rounded-full blur-3xl opacity-60" style="background:#FDE9E1;"></div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-14 sm:pt-20 pb-12 sm:pb-16">
      <p class="text-xs sm:text-sm font-black uppercase tracking-widest text-tc-orange mb-5">Services</p>
      <h1 class="text-4xl sm:text-5xl font-black leading-[1.05] text-tc-ink text-balance max-w-2xl">
        Find the right starting point for your brand.
      </h1>
      <p class="mt-6 text-base sm:text-lg text-tc-gray max-w-xl leading-relaxed">
        Every engagement starts in a different place — building from nothing,
        aligning what's already there, or keeping the marketing moving month
        to month. Here's where each one fits.
      </p>

      <div class="mt-8 grid sm:grid-cols-2 gap-3 max-w-xl">
        <a href="#foundations" class="rounded-xl border border-tc-line bg-white px-5 py-4 hover:border-tc-orange transition-colors">
          <p class="text-sm font-bold text-tc-ink">Starting from zero?</p>
          <p class="mt-1 text-sm text-tc-gray">Jump to Built Brand Foundations →</p>
        </a>
        <a href="#alignment" class="rounded-xl border border-tc-line bg-white px-5 py-4 hover:border-tc-orange transition-colors">
          <p class="text-sm font-bold text-tc-ink">Have a brand that needs to catch up?</p>
          <p class="mt-1 text-sm text-tc-gray">Jump to Brand Alignment →</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Built Brand Foundations -->
  <section id="foundations" class="relative overflow-hidden scroll-mt-20 py-14 sm:py-20">
    <div class="absolute inset-0 -z-20 bg-tc-paper"></div>
    <Image
      src={architecturalSketch}
      alt=""
      role="presentation"
      class="absolute inset-0 -z-10 w-full h-full object-cover opacity-60 services-illustration-mask"
      width={1600}
      loading="lazy"
    />
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-widest text-tc-orange mb-3">Built Brand Foundations</p>
        <h2 class="text-2xl sm:text-3xl font-black text-tc-ink text-balance">Start here if you're building from the ground up.</h2>
        <p class="mt-4 text-base text-tc-gray leading-relaxed">
          A new brand, a new property, a new venture — this is the full path from
          a blank page to a brand that's ready to work, in three phases.
        </p>
      </div>

      <div class="mt-10 grid md:grid-cols-3 gap-5">
        {foundationsPhases.map((phase, i) => (
          <div class="relative rounded-2xl border border-tc-line bg-white shadow-sm p-6 sm:p-7 flex flex-col">
            <p class="text-xs font-mono font-bold text-tc-orange tracking-widest">{phase.number}</p>
            <h3 class="mt-3 text-lg font-black text-tc-ink">{phase.name}</h3>
            <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-tc-gray">{phase.timeline}</p>
            <p class="mt-4 text-sm text-tc-gray leading-relaxed flex-1">{phase.blurb}</p>
            <p class="mt-5 text-2xl font-black text-tc-ink">
              {phase.price}<span class="text-base font-bold text-tc-gray">{phase.priceNote}</span>
            </p>
            {i < foundationsPhases.length - 1 && (
              <div class="hidden md:flex absolute top-7 -right-3 z-10 h-6 w-6 items-center justify-center rounded-full bg-tc-orange text-white">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs text-tc-gray">*Brand Build scope varies by number of applications needed — final price confirmed after Phase I.</p>

      <div class="mt-8">
        <a href="/contact" class="inline-flex justify-center items-center text-sm sm:text-base font-bold text-white bg-tc-orange rounded-xl px-6 py-3.5 shadow-lg hover:opacity-90 transition-opacity">
          Book a Call to Start Your Brand
        </a>
      </div>
    </div>
  </section>

  <!-- Brand Alignment -->
  <section id="alignment" class="border-y border-tc-line bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 scroll-mt-20">
      <div class="grid md:grid-cols-2 gap-10 md:gap-16">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-tc-orange mb-3">Brand Alignment</p>
          <h2 class="text-2xl sm:text-3xl font-black text-tc-ink text-balance">
            Start here if you already have a logo and colors — just no system tying it together.
          </h2>
          <p class="mt-4 text-base text-tc-gray leading-relaxed">
            This is the most common gap we see in growing companies: the pieces
            exist, but nothing keeps them consistent as the business — and the
            team — gets bigger.
          </p>
          <p class="mt-6 text-3xl font-black text-tc-ink">
            Starting at $9,500
          </p>
          <a href="/contact" class="mt-6 inline-flex justify-center items-center text-sm sm:text-base font-bold text-white bg-tc-orange rounded-xl px-6 py-3.5 shadow-lg hover:opacity-90 transition-opacity">
            Book a Call to Align Your Brand
          </a>
        </div>

        <div class="space-y-5">
          {alignmentStages.map((stage) => (
            <div class="rounded-2xl border border-tc-line bg-tc-paper p-6">
              <p class="text-xs font-mono font-bold text-tc-orange tracking-widest">{stage.number}</p>
              <h3 class="mt-2 text-lg font-black text-tc-ink">{stage.name}</h3>
              <p class="mt-2 text-sm text-tc-gray leading-relaxed">{stage.blurb}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Monthly Marketing -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
    <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-tc-orange mb-3">Monthly Marketing</p>
        <h2 class="text-2xl sm:text-3xl font-black text-tc-ink text-balance">
          Already have a brand you're proud of? Keep the marketing moving.
        </h2>
        <p class="mt-4 text-base text-tc-gray leading-relaxed">
          A fixed rate, fast turnaround, and the flexibility to cancel anytime —
          flyers and brochures, offering memorandums, social graphics, print
          and web ads, presentations, website design, and more.
        </p>
      </div>
      <Image
        src={marketingImg}
        alt="Apex Industrial leasing brochure mockup — an example of ongoing marketing collateral"
        class="rounded-2xl shadow-lg w-full aspect-[4/3] object-cover"
        width={600}
        loading="lazy"
      />
    </div>

    <div class="mt-10 grid sm:grid-cols-2 gap-5 max-w-3xl">
      {marketingTiers.map((tier) => (
        <div class={`rounded-2xl border p-6 sm:p-7 flex flex-col ${tier.featured ? 'border-tc-orange bg-white shadow-md' : 'border-tc-line bg-white shadow-sm'}`}>
          <p class="text-3xl font-black text-tc-ink">{tier.price}<span class="text-base font-bold text-tc-gray">/mo</span></p>
          <ul class="mt-4 space-y-2 flex-1">
            {tier.features.map((feature) => (
              <li class="flex items-start gap-2 text-sm text-tc-gray">
                <svg class="h-4 w-4 mt-0.5 shrink-0 text-tc-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
          <a
            href="/contact"
            class={`mt-6 inline-flex justify-center items-center text-sm font-bold rounded-xl px-6 py-3 transition-opacity ${
              tier.featured ? 'text-white bg-tc-orange hover:opacity-90' : 'text-tc-orange border-2 border-tc-orange hover:bg-tc-orange hover:text-white'
            }`}
          >
            Join Today
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Not sure -->
  <section class="relative overflow-hidden border-t border-tc-line">
    <div class="absolute inset-0 -z-20 bg-white"></div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-24 text-center">
      <h2 class="text-2xl sm:text-3xl font-black text-tc-ink text-balance max-w-xl mx-auto">
        Not sure which one fits?
      </h2>
      <p class="mt-3 text-base text-tc-gray max-w-md mx-auto">
        Take the free Brand Review — it only takes a few minutes, and the
        results point you to a starting place.
      </p>
      <div class="mt-8">
        <a href="/brand-review" class="inline-flex justify-center items-center text-sm sm:text-base font-bold text-tc-orange border-2 border-tc-orange rounded-xl px-6 py-3.5 hover:bg-tc-orange hover:text-white transition-colors">
          Take the Free Brand Review
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Vignette-fade the architectural illustration to transparent at its
     edges so its rectangular canvas dissolves into the page background
     instead of showing a hard cutoff. The source file already carries a
     flat 50% alpha throughout, so this mask only shapes the fade.
     Tuned for a tall box (intro + three cards + CTA) — a tighter ellipse
     here would fade almost the whole image out before it reaches the
     card row. */
  .services-illustration-mask {
    mask-image: radial-gradient(ellipse 85% 90% at 50% 30%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 85% 90% at 50% 30%, black 40%, transparent 100%);
  }
</style>
