---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, path, ogImage, ogType } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logos/tingen-creative-icon.png" />
    <SEO title={title} description={description} path={path} ogImage={ogImage} ogType={ogType} />
  </head>
  <body class="min-h-screen flex flex-col bg-tc-paper text-tc-ink antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
