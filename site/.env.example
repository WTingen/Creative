# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# From the Resend dashboard (Settings -> API Keys), after your sending
# domain is verified. Confirmation emails are silently skipped if this
# is unset, so the site still works without it — leads just won't get
# a confirmation email until this is set.
RESEND_API_KEY=

# Must be an address on a domain you've verified in Resend (e.g.
# tingencreative.com). Format: "Display Name <address@domain.com>"
RESEND_FROM_EMAIL="Tingen Creative <warren@tingencreative.com>"

# Google Sheets logging (newsletter signups, Brand Review results, contact
# messages). Optional — rows are silently skipped if unset. Requires a GCP
# service account with the Sheets API enabled, shared as an Editor on the
# target spreadsheet.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Cloudflare Turnstile (spam protection on the contact + subscribe forms).
# From dash.cloudflare.com -> Turnstile -> Add site (hostname
# tingencreative.com). Set both or neither: the site key is baked in at
# build time, the secret is checked server-side. Unset = honeypot and
# timing checks only.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
