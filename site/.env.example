# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# From the Resend dashboard (Settings -> API Keys), after your sending
# domain is verified. Confirmation emails are silently skipped if this
# is unset, so the site still works without it — leads just won't get
# a confirmation email until this is set.
RESEND_API_KEY=

# Must be an address on a domain you've verified in Resend (e.g.
# tingencreative.com). Format: "Display Name <address@domain.com>"
RESEND_FROM_EMAIL="Tingen Creative <warren@tingencreative.com>"
